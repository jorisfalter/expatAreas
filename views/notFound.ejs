<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', {
    title: 'Not found | Expat Areas',
    description: 'This destination is not on the map (yet).',
    path: '/'
  }) %>
  <meta name="robots" content="noindex">
</head>
<body>
  <%- include('partials/header') %>
  <main class="wrap not-found">
    <h1>That place isn't on the map (yet).</h1>
    <p class="lede">Try one of these instead:</p>
    <ul class="pill-list">
      <% regions.forEach(function (r) { %>
        <li><a href="/<%= r.slug %>"><%= r.name %></a></li>
      <% }) %>
    </ul>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
