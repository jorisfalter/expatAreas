<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', {
    title: 'Expat Areas: where to live and work remotely with your family',
    description: 'A hand-picked map of ' + regions.length + ' places where remote-working families can live: honest pros and cons, schools, communities and walkability.',
    path: '/',
    image: '/img/hero/' + regions[0].properties.pic.replace('.avif', '.webp')
  }) %>
  <link href="https://unpkg.com/maplibre-gl@5.12.0/dist/maplibre-gl.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <section class="hero wrap">
      <p class="eyebrow">For remote workers with kids</p>
      <h1>Find a place where your family can actually <em>live</em>.</h1>
      <p class="lede">An honest, hand-curated map of <%= regions.length %> destinations: why you'd move there, why you might not, and what it's like for schools, community and getting around.</p>
    </section>

    <section id="map-section" class="wrap">
      <div class="chips" role="toolbar" aria-label="Jump to a part of the world">
        <button class="chip" data-view="full">Whole world</button>
        <button class="chip is-active" data-view="mediterranean">Mediterranean</button>
        <button class="chip" data-view="greece">Greece</button>
        <button class="chip" data-view="iberia">Iberia</button>
        <button class="chip" data-view="caribbean">Caribbean</button>
        <button class="chip" data-view="southeastAsia">Southeast Asia</button>
        <button class="chip" data-view="scandinavia">Scandinavia</button>
      </div>
      <div class="map-frame">
        <div id="map" aria-label="Map of destinations"></div>
        <div id="tooltip" role="status"></div>
      </div>
      <p class="map-hint muted">Tap a highlighted area to open its guide.</p>
    </section>

    <section id="destinations" class="wrap">
      <div class="section-head">
        <h2>All destinations</h2>
        <div class="chips" role="toolbar" aria-label="Filter destinations">
          <button class="chip is-active" data-filter="all">All</button>
          <% areas.forEach(function (a) { %>
            <button class="chip" data-filter="<%= a %>"><%= a %></button>
          <% }) %>
        </div>
      </div>

      <ul class="card-grid">
        <% regions.forEach(function (r) { %>
          <li class="card" data-area="<%= r.area %>" data-slug="<%= r.slug %>">
            <a href="/<%= r.slug %>">
              <img src="/img/thumb/<%= r.properties.pic.replace('.avif', '.webp') %>" alt="<%= r.name %>" loading="lazy" width="720" height="480">
              <div class="card-body">
                <p class="card-meta"><%= r.country %></p>
                <h3><%= r.name %></h3>
                <p class="card-why"><%= r.properties.why.replace(/<[^>]*>/g, ' ') %></p>
              </div>
            </a>
          </li>
        <% }) %>
      </ul>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="https://unpkg.com/maplibre-gl@5.12.0/dist/maplibre-gl.js"></script>
  <script src="/index.js"></script>
</body>
</html>
