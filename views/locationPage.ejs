<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', {
    title: city.name + ', ' + city.country + ' for expat families | Expat Areas',
    description: description,
    path: '/' + city.slug,
    image: '/img/hero/' + city.properties.pic.replace('.avif', '.webp')
  }) %>
</head>
<body>
  <%- include('partials/header') %>

  <main>
    <section class="city-hero" style="background-image: url('/img/hero/<%= city.properties.pic.replace('.avif', '.webp') %>')">
      <div class="city-hero-shade">
        <div class="wrap">
          <a class="back-link" href="/#destinations">← All destinations</a>
          <p class="eyebrow light"><%= city.country %> · <%= city.area %></p>
          <h1><%= city.name %></h1>
        </div>
      </div>
      <span class="photo-credit">Photo: <%= city.properties.picowner %></span>
    </section>

    <div class="wrap city-content">
      <div class="verdict">
        <article class="verdict-card pro">
          <h2><span aria-hidden="true">👍</span> Why <%= city.name %>?</h2>
          <p><%- city.properties.why %></p>
        </article>
        <article class="verdict-card con">
          <h2><span aria-hidden="true">🤔</span> Why not?</h2>
          <p><%- city.properties.whyNot %></p>
        </article>
      </div>

      <% if (facts.length) { %>
        <dl class="facts">
          <% facts.forEach(function (f) { %>
            <div><dt><%= f[0] %></dt><dd><%= f[1] %></dd></div>
          <% }) %>
        </dl>
      <% } %>

      <% if (sections.length) { %>
        <div class="info-grid">
          <% sections.forEach(function (s) { %>
            <section class="info-card">
              <h2><span aria-hidden="true"><%= s[2] %></span> <%= s[1] %></h2>
              <div><%- city.properties[s[0]] %></div>
            </section>
          <% }) %>
        </div>
      <% } %>

      <% if (Array.isArray(city.properties.reviews) && city.properties.reviews.length) { %>
        <section class="voices">
          <h2>What people say</h2>
          <% city.properties.reviews.forEach(function (rv) { %>
            <blockquote><%- rv %></blockquote>
          <% }) %>
        </section>
      <% } %>

      <% if (related.length) { %>
        <section class="related">
          <h2>More in <%= city.area %></h2>
          <ul class="card-grid small">
            <% related.forEach(function (r) { %>
              <li class="card">
                <a href="/<%= r.slug %>">
                  <img src="/img/thumb/<%= r.properties.pic.replace('.avif', '.webp') %>" alt="<%= r.name %>" loading="lazy" width="720" height="480">
                  <div class="card-body">
                    <p class="card-meta"><%= r.country %></p>
                    <h3><%= r.name %></h3>
                  </div>
                </a>
              </li>
            <% }) %>
          </ul>
        </section>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
